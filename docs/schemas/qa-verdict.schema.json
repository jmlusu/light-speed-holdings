{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ls-artifact-qa verdict",
  "description": "Written by the QA step AFTER rendering the deck to images and reviewing them. verify-deck.py binds it to the deck by sha256, so editing the deck invalidates it.",
  "type": "object",
  "required": ["schema_version", "verdict", "generated_by", "artifact", "checks", "evidence"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "verdict": { "enum": ["APPROVE", "FIX"] },
    "generated_by": { "type": "string", "minLength": 1 },
    "artifact": {
      "type": "object", "required": ["path", "sha256"],
      "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
    },
    "checks": {
      "type": "array", "minItems": 5,
      "items": {
        "type": "object", "required": ["pass", "result"],
        "properties": {
          "pass": { "enum": ["visual", "brand", "ux", "accessibility", "content"] },
          "result": { "enum": ["PASS", "FAIL"] },
          "notes": { "type": "string" }
        }
      }
    },
    "evidence": {
      "description": "One rendered image per slide (>= 640px wide), paths relative to this file, with sha256.",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "sha256"],
        "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
      }
    }
  }
}
