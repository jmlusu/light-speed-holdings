---
---
<div class="pt-24 md:pt-32">
  <div class="ls-shell max-w-[1000px] mx-auto">
    <div class="bg-[var(--ls-cream)] border-y border-[var(--ls-divider)] py-12 md:py-16">
      <div class="ls-shell grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-8 items-center">
        <div>
          <h2 class="font-semibold tracking-[-0.02em] text-[clamp(1.6rem,4vw,2.2rem)] leading-[1.1]">Begin your AI transformation.</h2>
          <p class="mt-3 text-[var(--ls-text-secondary)] max-w-[52ch]">Copy the command, or start a conversation with our team. No gatekeeping — the CLI is the proof.</p>
          <div class="mt-6 rounded-[10px] bg-[var(--ls-ink)] text-white p-5 font-mono text-[0.84rem] flex items-center justify-between gap-3">
            <code class="truncate">uv sync && ai-company company run</code>
            <button class="shrink-0 rounded-[6px] bg-white text-[var(--ls-ink)] px-4 py-2 font-semibold text-[0.76rem]" data-track="click_final_cta_copy">copy</button>
          </div>
          <div class="mt-4 flex flex-wrap gap-3">
            <a
              href="/contact"
              class="inline-flex rounded-[10px] bg-[var(--ls-ink)] text-white px-5 py-3 text-[0.9rem] font-medium hover:opacity-90 transition"
              data-track="click_start_conversation"
            >
              Start a conversation →
            </a>
            <a
              href="https://github.com/jmlusu/light-speed-holdings"
              class="inline-flex rounded-[10px] border border-[var(--ls-ink)] px-5 py-3 text-[0.9rem] font-medium hover:bg-[var(--ls-sage)] transition"
              data-track="click_github_repo"
            >
              View on GitHub ↗
            </a>
          </div>
        </div>

        <div class="rounded-[16px] border border-[var(--ls-card-border)] shadow-[var(--ls-shadow-card)] overflow-hidden bg-white">
          <div class="p-5 border-b border-[var(--ls-divider)] bg-[var(--ls-pearl)]">
            <div class="font-semibold">Book a 30-min call</div>
            <div class="font-mono text-[0.74rem] text-[var(--ls-ink-muted)] mt-0.5">calendar · human handoff</div>
          </div>
          <div id="cal-inline" class="min-h-[380px] grid place-items-center bg-[var(--ls-pearl)] p-6 text-center">
            <div>
              <p class="text-[0.9rem] text-[var(--ls-ink-muted)]">Scheduling via Cal.com (free tier) — configure in env</p>
              <a href="/contact" class="mt-3 inline-flex rounded-[10px] bg-[var(--ls-ink)] text-white px-5 py-2.5 text-[0.9rem] font-medium">Go to contact</a>
              <p class="mt-3 text-[0.72rem] text-[var(--ls-ink-muted)]">Set <code>CAL_LINK</code> in Vercel env to embed inline.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
