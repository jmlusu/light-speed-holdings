---
import BaseLayout from "../layouts/BaseLayout.astro";
import Thesis from "../components/Thesis.astro";
import Methodology from "../components/Methodology.astro";
import Services from "../components/Services.astro";
import UseCases from "../components/UseCases.astro";
import AiCompanyBuilder from "../components/AiCompanyBuilder.astro";
import AfricaPositioning from "../components/AfricaPositioning.astro";
import Research from "../components/Research.astro";
import FinalCTA from "../components/FinalCTA.astro";
---

<BaseLayout
  title="LightSpeed Holdings — AI-Native Enterprise Transformation"
  description="LightSpeed Holdings helps organisations become AI-native by redesigning how people, agents, workflows, data and governance work together—and proves the model by building and operating an AI-native company itself."
>
  {/* ── SECTION 1: HERO ────────────────────────────────────────────── */}
  <section class="bg-[var(--ls-cream)] pt-[88px] md:pt-[104px] pb-[40px]">
    <div class="ls-shell grid grid-cols-1 lg:grid-cols-[0.92fr_1.08fr] gap-10 lg:gap-12 items-center">
      <div>
        <h1 class="font-semibold tracking-[-0.03em] leading-[1.06] text-[clamp(2.3rem,4vw,3.5rem)]">
          Building the AI-native enterprise.
        </h1>

        <p class="mt-6 max-w-[52ch] text-[1.02rem] md:text-[1.09rem] leading-[1.7] text-[var(--ls-text-secondary)]">
          LightSpeed Holdings helps organisations redesign how work gets done—combining executive strategy, agentic AI, automation, data and governance into a new operating model.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-3 rounded-[10px] bg-[var(--ls-ink)] text-white px-5 py-3.5 font-mono text-[0.82rem] md:text-[0.86rem] hover:bg-[#17293a] transition"
            data-track="click_hero_start_conversation"
            aria-label="Start a conversation"
          >
            <span class="opacity-70">→</span>
            Start a conversation
          </a>
          <a
            href="/ai-company-builder"
            class="inline-flex items-center justify-center gap-3 rounded-[10px] bg-white/15 text-[var(--ls-ink)] px-5 py-3.5 font-mono text-[0.82rem] md:text-[0.86rem] hover:bg-white/10 transition"
            data-track="click_hero_explore_builder"
            aria-label="Explore the AI Company Builder"
          >
            <span class="ml-1 inline-flex rounded-[6px] bg-white/15 px-2.5 py-1 text-[0.7rem] tracking-wide">Explore the AI Company Builder</span>
          </a>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[0.84rem] text-[var(--ls-ink-muted)]">
          <span class="flex items gap-1">
            <span class="inline-block w-2 h-2 rounded-full bg-[var(--ls-accent)]" aria-hidden="true"></span>
            Malawi · SADC · Africa
          </span>
          <span>·</span>
          <span>Strategy · Agentic AI · Enterprise Automation · Governance</span>
        </div>
      </div>

      {/* AI Company Builder proof callout */}
      <div class="rounded-[16px] bg-white border border-[var(--ls-edge)] shadow-[var(--ls-shadow-card)] p-6 flex flex-col lg:flex-row items-start gap-6">
        <h3 class="font-semibold text-[0.88rem] text-[var(--ls-ink-muted)] mb-2">We build what we describe</h3>
        <p class="text-[0.82rem] text-[var(--ls-text-secondary)]">
          The LightSpeed AI Company Builder is our living laboratory for the AI-native enterprise. We do not merely advise organisations to become AI-native — we are building and testing the operating model ourselves.
        </p>
        <div class="flex flex-col lg:flex-row gap-3 pt-2 lg:pt-0">
          <span class="text-[0.72rem] text-[var(--ls-ink-muted)]">144 AI agents</span>
          <span class="text-[0.72rem] text-[var(--ls-ink-muted)]">20 departments</span>
          <span class="text-[0.72rem] text-[var(--ls-ink-muted)]">5-tier governance</span>
        </div>
      </div>
    </div>
  </section>

  {/* ── SECTION 2: THESIS ────────────────────────────────────────────── */}
  <Thesis />

  {/* ── SECTION 3: METHODOLOGY ────────────────────────────────────────────── */}
  <Methodology />

  {/* ── SECTION 4: SERVICES ────────────────────────────────────────────── */}
  <Services />

  {/* ── SECTION 5: USE CASES ────────────────────────────────────────────── */}
  <UseCases />

  {/* ── SECTION 6: AI COMPANY BUILDER PROOF ────────────────────────────────────────────── */}
  <AiCompanyBuilder />

  {/* ── SECTION 7: AFRICA/SADC POSITIONING ────────────────────────────────────────────── */}
  <AfricaPositioning />

  {/* ── SECTION 8: RESEARCH ────────────────────────────────────────────── */}
  <Research />

  {/* ── SECTION 9: FINAL CTA ────────────────────────────────────────────── */}
  <FinalCTA />
</BaseLayout>
