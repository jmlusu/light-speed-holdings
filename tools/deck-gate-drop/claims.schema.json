{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightspeed.local/schemas/claims.schema.json",
  "title": "LightSpeed deck claims registry",
  "description": "Every number, price, market size, KPI, client or traction statement that may appear on a slide (or in speaker notes) must have an entry here. verify-deck.py rejects any number on a slide that is not covered by a verified claim or a structural allowance.",
  "type": "object",
  "required": ["schema_version", "claims"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "structural": {
      "description": "Tokens that are layout/spec constants, not factual claims (e.g. '90-day' roadmap horizon). Each needs a reason; a reviewer should be able to say 'yes, that is just structure'.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["display", "reason"],
        "additionalProperties": false,
        "properties": {
          "display": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 10 },
          "slides": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "forbidden_patterns": {
      "description": "Case-insensitive regexes that must never appear on a slide.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern"],
        "additionalProperties": false,
        "properties": { "pattern": { "type": "string" }, "reason": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "humanOrActor": { "type": "string", "pattern": "^(human|ci|agent):\\S+$" },
    "humanOnly": { "type": "string", "pattern": "^human:\\S+$" },
    "claim": {
      "type": "object",
      "required": ["id", "display", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
        "display": {
          "description": "Exact strings as they appear on slides (whitespace, dash and x/times variants are normalised; case ignored). Include the unit and noun ('90 agents', '$65B'), not a bare digit, so the licence stays narrow.",
          "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
        },
        "statement": { "type": "string", "description": "Plain-language meaning of the claim." },
        "type": { "enum": ["count", "currency", "percentage", "multiple", "duration", "date", "market-size", "price", "client", "other"] },
        "status": {
          "enum": ["verified", "unverified", "placeholder", "retracted"],
          "description": "Only 'verified' claims may appear on slides."
        },
        "verified_on": { "type": "string", "format": "date" },
        "verified_by": { "$ref": "#/$defs/humanOrActor" },
        "max_age_days": { "type": "integer", "minimum": 1, "description": "Overrides the tool default (90)." },
        "slides": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "description": "Restrict where the claim may be shown." },
        "derivation": { "type": "string", "description": "Required when a number in display is computed rather than quoted (e.g. a range or sum)." },
        "source": { "$ref": "#/$defs/source" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
          "then": { "required": ["verified_on", "verified_by", "source"] }
        }
      ]
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "enum": ["file", "url", "document", "command", "attestation"] } },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "file" },
            "path": { "type": "string", "description": "Repo-relative; must stay inside --root." },
            "quote": { "type": "string", "minLength": 3, "description": "Exact text found in the file that proves the claim. verify-deck.py greps for it." }
          },
          "required": ["kind", "path", "quote"], "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "enum": ["url", "document"] },
            "locator": { "type": "string", "description": "URL, or document name + page/section." },
            "quote": { "type": "string", "minLength": 3 },
            "retrieved_on": { "type": "string", "format": "date" }
          },
          "required": ["kind", "locator", "quote", "retrieved_on"], "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "command" },
            "command": { "type": "string" },
            "recorded_output": { "type": "string" },
            "recorded_on": { "type": "string", "format": "date" }
          },
          "required": ["kind", "command", "recorded_output", "recorded_on"], "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "attestation" },
            "attested_by": { "$ref": "#/$defs/humanOnly" },
            "record": { "type": "string", "description": "Where the decision/commitment is recorded (e.g. decision-register ID)." }
          },
          "required": ["kind", "attested_by", "record"], "additionalProperties": false
        }
      ]
    }
  }
}
