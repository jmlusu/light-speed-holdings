# Set default behavior for git commands
* text=auto eol=lf

# OpenCode agent definitions, operating standards, and configurations (must be LF)
/.opencode/agents/*.md text eol=lf
/.opencode/operating-standards.md text eol=lf
/.opencode/config/*.yaml text eol=lf
/.opencode/skills/**/*.md text eol=lf
/company-registry.yaml text eol=lf
/AGENTS.md text eol=lf

# Harness index
/harness/changes/INDEX.json text eol=lf

# Source files & config
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.css text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Lockfiles & package-manager config: never overwrite the local copy on merge
# (AI Studio syncs may rewrite them; ADR-024 keeps bun.lock authoritative).
bun.lock merge=ours_lockfile
uv.lock merge=ours_lockfile
package-lock.json merge=ours_lockfile
.npmrc merge=ours_lockfile

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.tar.gz binary
