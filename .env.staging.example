# AI Company Builder — Staging Environment Variables
# Copy to .env.staging and fill in real values. NEVER commit .env.staging.

# API keys for LLM providers
OPENCODE_API_KEY=your_opencode_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
KIMI_API_KEY=your_kimi_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Dashboard configuration
DASHBOARD_API_KEY=your_dashboard_api_key_here
DASHBOARD_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DASHBOARD_RATE_LIMIT=200
AI_COMPANY_ENV=staging
