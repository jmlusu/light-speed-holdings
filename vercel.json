{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/offerings",
      "destination": "/solutions",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/evidence",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/enquiry.ts": { "regions": ["iad1"] },
    "api/ping.ts": { "regions": ["iad1"] },
    "api/ping-nodejs.js": { "regions": ["iad1"] }
  }
}
