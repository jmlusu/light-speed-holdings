---
import BaseLayout from "../layouts/BaseLayout.astro";
import product from "../content/product.json";
---

<BaseLayout title="Features — 30 commands, 9 workflows, 6 memory types" description="Everything from MessageBus to ToolRunner — feature matrix with file_path:line_number receipts. Live via product-meta.json (144 agents, 20 depts).">
  <section class="bg-[var(--ls-cream)] py-16 md:py-20">
    <div class="ls-inner max-w-[880px]">
      <h1 class="font-semibold tracking-[-0.02em] text-[clamp(1.9rem,4vw,2.6rem)]">Features — 30 commands, 9 workflows, 6 memory types</h1>
      <p class="mt-3 text-[var(--ls-text-secondary)] max-w-[60ch]">Everything from MessageBus to ToolRunner — feature matrix with file_path:line_number receipts. Live: <code class="font-mono text-[0.82rem]">{product.agents.total} agents</code> · <code class="font-mono text-[0.82rem]">{Object.keys(product.agents.byDept).length} depts</code> · <code class="font-mono text-[0.82rem]">20/20 GAPs</code> · <code class="font-mono text-[0.82rem]">1969 tests</code>.</p>
      <div class="mt-6 flex gap-3">
        <a href="/" class="inline-flex rounded-full bg-[var(--ls-ink)] text-white px-5 py-3 text-[0.9rem] font-medium">Back to home →</a>
        <a href="/contact" class="inline-flex rounded-full border border-[var(--ls-ink)] px-5 py-3 text-[0.9rem] font-medium">Book deployment</a>
      </div>
    </div>
  </section>
  <section class="ls-shell max-w-[880px] py-8 space-y-6">
    <div class="rounded-[16px] border border-[var(--ls-card-border)] bg-white p-6">
      <h2 class="font-semibold">Core engines</h2>
      <div class="mt-4 grid md:grid-cols-2 gap-4 text-[0.88rem]">
        <div class="rounded-[12px] bg-[var(--ls-pearl)] border border-[var(--ls-divider)] p-4"><div class="font-semibold">Generator</div><div class="text-[var(--ls-text-secondary)] mt-1"><code class="font-mono text-[0.78rem]">src/ai_company/generator.py</code> · 12 Jinja2 → <code class="font-mono text-[0.78rem]">.opencode/agents/*.md</code> · deterministic, idempotent</div></div>
        <div class="rounded-[12px] bg-[var(--ls-pearl)] border border-[var(--ls-divider)] p-4"><div class="font-semibold">MessageBus</div><div class="text-[var(--ls-text-secondary)] mt-1"><code class="font-mono text-[0.78rem]">src/ai_company/orchestrator/message_bus.py</code> · <code class="font-mono text-[0.78rem]">.opencode/inbox.json</code> · leases, FileStore locking, 5-tier approvals</div></div>
        <div class="rounded-[12px] bg-[var(--ls-pearl)] border border-[var(--ls-divider)] p-4"><div class="font-semibold">AgentLoop + ToolRunner</div><div class="text-[var(--ls-text-secondary)] mt-1"><code class="font-mono text-[0.78rem]">src/ai_company/executor/</code> · ReAct · shlex · tier_rules · audit JSONL · <code class="font-mono text-[0.78rem]">.opencode/reminders/</code></div></div>
        <div class="rounded-[12px] bg-[var(--ls-pearl)] border border-[var(--ls-divider)] p-4"><div class="font-semibold">Memory &amp; Graph</div><div class="text-[var(--ls-text-secondary)] mt-1"><code class="font-mono text-[0.78rem]">memory/</code> 6 types · <code class="font-mono text-[0.78rem]">graph/engine.py</code> 4 graphs · BFS · OrgNode metrics/risk (0.6.0)</div></div>
        <div class="rounded-[12px] bg-[var(--ls-pearl)] border border-[var(--ls-divider)] p-4"><div class="font-semibold">Dashboard &amp; KPIs</div><div class="text-[var(--ls-text-secondary)] mt-1"><code class="font-mono text-[0.78rem]">src/ai_company/dashboard/</code> · FastAPI · WS task/KPI/alerts · 20 dept KPI collectors · Alert Center (0.6.0) · Executive Scorecard (10 KPIs)</div></div>
        <div class="rounded-[12px] bg-[var(--ls-pearl)] border border-[var(--ls-divider)] p-4"><div class="font-semibold">Governance</div><div class="text-[var(--ls-text-secondary)] mt-1"><code class="font-mono text-[0.78rem]">orchestrator/approvals.yaml</code> · 5-tier matrix · HITL expiry sweep · <code class="font-mono text-[0.78rem]">cost_log.jsonl</code> · <code class="font-mono text-[0.78rem]">llm/circuit_breaker.py</code></div></div>
      </div>
    </div>
    <div class="rounded-[16px] border border-[var(--ls-card-border)] bg-white p-6">
      <h2 class="font-semibold">What's new in v0.6.0 (source: CHANGELOG.md head)</h2>
      <ul class="mt-3 space-y-1.5 text-[0.9rem] text-[var(--ls-text-secondary)] list-disc pl-5">
        <li>CEO Alert Center — AlertStore + API + WS + scheduler + jarvis-glass UI (17 tests)</li>
        <li>Executive KPI Scorecard — 10 targets + trends (period_comparison, moving_average, anomaly)</li>
        <li>Org Chart Metrics &amp; Risk — capacity/activity/trend + succession/bus-factor, 30s TTL, X-Org-Summary</li>
      </ul>
      <p class="mt-3 text-[0.82rem] text-[var(--ls-ink-muted)]">By type: <code class="font-mono">{product.agents.byType.executive} exec</code> · <code class="font-mono">{product.agents.byType.specialist} specialist</code> · <code class="font-mono">{product.agents.byType.board} board</code> — Marketing now {product.agents.byDept.Marketing} (added media_generation_owner).</p>
    </div>
  </section>
</BaseLayout>
