---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Not found" description="The page you requested does not exist.">
  <section class="ls-inner max-w-[880px] py-20 text-center">
    <h1 class="font-semibold tracking-[-0.02em] text-[clamp(1.9rem,4vw,2.6rem)]">404 — Not found</h1>
    <p class="mt-3 text-[var(--ls-text-secondary)]">Try <a href="/" class="underline">home</a>, <a href="/platform" class="underline">platform</a>, or <a href="/docs" class="underline">docs</a>.</p>
  </section>
</BaseLayout>
