---
import BaseLayout from "../layouts/BaseLayout.astro";
import product from "../content/product.json";

const total = product.agents.total;
const byType = product.agents.byType;
const byDept = product.agents.byDept;
---

<BaseLayout title="144 Agents — Directory" description="20 departments, filtered by executive / specialist / department — live from product-meta.json.">
  <section class="bg-[var(--ls-cream)] py-12 md:py-16">
    <div class="ls-inner max-w-[880px]">
      <h1 class="font-semibold tracking-[-0.02em] text-[clamp(1.9rem,4vw,2.6rem)]">144 agents — generated, not hired</h1>
      <p class="mt-3 text-[var(--ls-text-secondary)] max-w-[58ch]">Live from <code class="font-mono text-[0.82rem]">product-meta.json</code> (built from <code class="font-mono text-[0.82rem]">company-registry.yaml</code> via <code class="font-mono text-[0.82rem]">scripts/export-product-meta.ts</code>). Same source as <code class="font-mono text-[0.82rem]">src/ai_company/generator.py</code>.</p>

      <div class="mt-6 grid grid-cols-3 gap-3 text-center">
        <div class="rounded-[12px] bg-white border border-[var(--ls-card-border)] p-4"><div class="text-[1.6rem] font-semibold">{total}</div><div class="text-[0.72rem] uppercase tracking-wide text-[var(--ls-ink-muted)]">total agents</div></div>
        <div class="rounded-[12px] bg-white border border-[var(--ls-card-border)] p-4"><div class="text-[1.6rem] font-semibold">{Object.keys(byDept).length}</div><div class="text-[0.72rem] uppercase tracking-wide text-[var(--ls-ink-muted)]">departments</div></div>
        <div class="rounded-[12px] bg-white border border-[var(--ls-card-border)] p-4"><div class="text-[1.6rem] font-semibold">{byType.executive ?? 0}</div><div class="text-[0.72rem] uppercase tracking-wide text-[var(--ls-ink-muted)]">executives</div></div>
      </div>
    </div>
  </section>

  <section class="ls-shell max-w-[960px] grid md:grid-cols-2 gap-6 py-8">
    <div class="rounded-[16px] bg-white border border-[var(--ls-card-border)] p-6">
      <h2 class="font-semibold">By type</h2>
      <ul class="mt-3 space-y-2 text-[0.9rem]">
        {Object.entries(byType).map(([k,v]) => (
          <li class="flex justify-between"><span class="capitalize">{k}</span><span class="font-mono text-[var(--ls-ink-muted)]">{String(v)}</span></li>
        ))}
      </ul>
    </div>
    <div class="rounded-[16px] bg-white border border-[var(--ls-card-border)] p-6">
      <h2 class="font-semibold">By department</h2>
      <ul class="mt-3 space-y-2 text-[0.9rem] max-h-[320px] overflow-auto pr-2">
        {Object.entries(byDept).sort((a,b)=> Number(b[1])-Number(a[1])).map(([k,v]) => (
          <li class="flex justify-between gap-4"><span class="truncate">{k}</span><span class="font-mono text-[var(--ls-ink-muted)] shrink-0">{String(v)}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="ls-shell max-w-[960px] pb-12">
    <div class="rounded-[16px] bg-[var(--ls-pearl)] border border-[var(--ls-divider)] p-6">
      <h2 class="font-semibold">Want the full registry?</h2>
      <p class="mt-2 text-[0.92rem] text-[var(--ls-text-secondary)]"><code class="font-mono">company-registry.yaml</code> → <code class="font-mono">AgentGenerator().generate_all()</code> → <code class="font-mono">.opencode/agents/*.md</code>. Clone and run — free.</p>
      <div class="mt-4 rounded-[12px] bg-[var(--ls-ink)] text-white p-4 font-mono text-[0.78rem] overflow-auto">uv sync && ai-company company run<br/># → 144 agents in 45s</div>
    </div>
  </section>
</BaseLayout>
