---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact — Book a deployment"
  description="Talk to the Human CEO + VP Eng, or just copy the install and go. Calendly/Cal.com embedded, Formspree fallback, Turnstile-protected."
>
  <section class="bg-[var(--ls-cream)] py-12 md:py-16">
    <div class="ls-inner max-w-[880px]">
      <h1 class="font-semibold tracking-[-0.02em] text-[clamp(1.9rem,4vw,2.6rem)]">Let's talk about your AI company.</h1>
      <p class="mt-3 text-[var(--ls-text-secondary)] max-w-[58ch]">Two paths — pick what fits your evaluation style. No gatekeeping.</p>

      <div class="mt-8 grid md:grid-cols-2 gap-4">
        <div class="rounded-[16px] bg-white border border-[var(--ls-card-border)] p-6">
          <div class="text-[0.78rem] uppercase tracking-[0.12em] text-[var(--ls-ink-muted)]">Fastest path</div>
          <div class="mt-1 font-semibold">Copy → Run → See 135 agents</div>
          <div class="mt-3 rounded-[12px] bg-[var(--ls-ink)] text-white p-4 font-mono text-[0.82rem] flex items-center justify-between gap-2">
            <code class="truncate">uv sync && ai-company company run</code>
            <button id="contact-copy" class="shrink-0 rounded-full bg-white text-[var(--ls-ink)] px-3 py-1.5 font-semibold text-[0.72rem]" data-track="click_contact_copy">Copy</button>
          </div>
          <p class="mt-3 text-[0.82rem] text-[var(--ls-ink-muted)]">Then <code>ai-company dashboard</code> → <code>http://127.0.0.1:8420</code>. No call required.</p>
        </div>

        <div class="rounded-[16px] bg-white border border-[var(--ls-card-border)] p-6">
          <div class="text-[0.78rem] uppercase tracking-[0.12em] text-[var(--ls-ink-muted)]">Human path</div>
          <div class="mt-1 font-semibold">Book 30 min with founders</div>
          <p class="mt-2 text-[0.88rem] text-[var(--ls-text-secondary)]">Cal.com embed loads on idle — set <code class="font-mono text-[0.78rem]">CAL_LINK</code> in Vercel env.</p>
          <a href="#cal" class="mt-3 inline-flex rounded-full bg-[var(--ls-ink)] text-white px-5 py-2.5 text-[0.88rem] font-medium" data-track="click_contact_cal">Pick a time ↓</a>
        </div>
      </div>
    </div>
  </section>

  <section class="ls-shell max-w-[960px] grid lg:grid-cols-[1fr_1.05fr] gap-6 pb-16">
    <!-- Lead form — Formspree/tally embed-first, honeypot + Turnstile ready -->
    <form
      action="https://formspree.io/f/xplaceholder"
      method="POST"
      class="rounded-[16px] bg-white border border-[var(--ls-card-border)] p-6"
      id="contact-form"
    >
      <h2 class="font-semibold text-[1.15rem]">Send a message</h2>
      <p class="text-[0.86rem] text-[var(--ls-ink-muted)] mt-1">Formspree free (50/mo) → email. No server. Replace <code class="font-mono">xplaceholder</code> with your ID or swap to Tally.</p>

      <div class="mt-5 grid grid-cols-2 gap-3">
        <label class="text-[0.84rem] font-medium">First name <input name="firstName" required autocomplete="given-name" class="mt-1 w-full rounded-[10px] border border-[var(--ls-warm)] px-3 py-2.5 focus:border-[var(--ls-ink)] focus:outline-none" /></label>
        <label class="text-[0.84rem] font-medium">Last name <input name="lastName" required autocomplete="family-name" class="mt-1 w-full rounded-[10px] border border-[var(--ls-warm)] px-3 py-2.5 focus:border-[var(--ls-ink)]" /></label>
      </div>
      <label class="mt-3 block text-[0.84rem] font-medium">Company <input name="company" required class="mt-1 w-full rounded-[10px] border border-[var(--ls-warm)] px-3 py-2.5 focus:border-[var(--ls-ink)]" /></label>
      <div class="mt-3 grid grid-cols-2 gap-3">
        <label class="text-[0.84rem] font-medium">Company size
          <select name="companySize" class="mt-1 w-full rounded-[10px] border border-[var(--ls-warm)] px-3 py-2.5 bg-white">
            <option>1-10</option><option>11-50</option><option>51-250</option><option>251-1000</option><option>1001-10k</option><option>10k+</option>
          </select>
        </label>
        <label class="text-[0.84rem] font-medium">Work email <input name="email" type="email" required autocomplete="email" class="mt-1 w-full rounded-[10px] border border-[var(--ls-warm)] px-3 py-2.5 focus:border-[var(--ls-ink)]" /></label>
      </div>
      <label class="mt-3 block text-[0.84rem] font-medium">Message <textarea name="message" rows="4" placeholder="What are you trying to build?" class="mt-1 w-full rounded-[10px] border border-[var(--ls-warm)] px-3 py-2.5 focus:border-[var(--ls-ink)]"></textarea></label>

      <!-- Honeypot — hidden from humans, not via type=hidden -->
      <div class="hidden" aria-hidden="true">
        <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <input type="hidden" name="_subject" value="New lead — lightspeedholdings.com" />

      <button type="submit" class="mt-4 w-full rounded-full bg-[var(--ls-ink)] text-white py-3 font-medium hover:opacity-90 transition" data-track="click_contact_submit">Send message</button>
      <p class="mt-3 text-[0.72rem] text-[var(--ls-ink-muted)]">Protected by Turnstile when configured. Submit via Formspree — or <a href="mailto:hello@lightspeedholdings.com" class="underline">email us directly</a>. No PII in URL.</p>
    </form>

    <!-- Cal inline -->
    <div id="cal" class="rounded-[16px] bg-white border border-[var(--ls-card-border)] overflow-hidden">
      <div class="p-5 border-b border-[var(--ls-divider)]">
        <div class="font-semibold">Book directly</div>
        <div class="text-[0.84rem] text-[var(--ls-ink-muted)]">Cal.com free — embed lazy-loads on idle. Fallback link below.</div>
      </div>
      <div id="cal-inline" class="min-h-[520px] bg-[var(--ls-pearl)] grid place-items-center p-6">
        <div class="text-center max-w-[32ch]">
          <p class="text-[0.9rem] text-[var(--ls-text-secondary)]">Cal inline placeholder</p>
          <p class="text-[0.78rem] text-[var(--ls-ink-muted)] mt-1">Set <code class="font-mono">CAL_LINK</code> in Vercel env (e.g. <code class="font-mono">cal.com/light-speed-holdings/30min</code>) to embed: <code class="font-mono">&lt;iframe src=&quot;https://cal.com/.../embed&quot;&gt;</code> with <code>frame-src https://cal.com</code> CSP. Until then, use external link.</p>
          <a href="https://cal.com" target="_blank" rel="noopener" class="mt-4 inline-flex rounded-full bg-[var(--ls-ink)] text-white px-5 py-2.5 text-[0.88rem] font-medium">Open Cal.com ↗</a>
        </div>
      </div>
      <div class="p-4 bg-[var(--ls-pearl)] text-[0.76rem] text-[var(--ls-ink-muted)]">By submitting, you agree to our <a href="/privacy" class="underline">privacy</a>. We use Formspree (processor) — no newsletter without double opt-in.</div>
    </div>
  </section>

  <script is:inline>
    const cmd = "uv sync && ai-company company run";
    document.getElementById('contact-copy')?.addEventListener('click', (e) => {
      navigator.clipboard?.writeText(cmd);
      const b = e.currentTarget; const t = b.textContent; b.textContent='Copied!'; setTimeout(()=>b.textContent=t,1200);
    });
    // Honeypot guard: if website filled, block
    document.getElementById('contact-form')?.addEventListener('submit', (e) => {
      const f = e.target;
      if (f.website && f.website.value) { e.preventDefault(); console.warn('honeypot'); return false; }
    });
  </script>
</BaseLayout>
