  <script is:inline>
    const cmd = "uv sync && ai-company company run";
    const copy = (btn) => {
      navigator.clipboard?.writeText(cmd);
      const orig = btn.textContent;
      btn.textContent = "copied ✓";
      setTimeout(() => (btn.textContent = orig), 1500);
    };
    document.getElementById("copy-install")?.addEventListener("click", (e) => copy(e.currentTarget.querySelector("span:last-child") || e.currentTarget));
    document.getElementById("cta-copy")?.addEventListener("click", (e) => copy(e.currentTarget));
    document.getElementById("sticky-copy")?.addEventListener("click", (e) => copy(e.currentTarget));
  </script>

  <script is:inline>
    // Single orchestrated moment — the org graph reveals once.
    const cap = document.getElementById("graph-cap");
    const svgs = {
      core: document.getElementById("org-graph"),
      full: document.getElementById("org-graph-full"),
    };
    const DEFAULTS = {
      core: "144 agents · 12 core departments · hover to isolate",
      full: "144 agents · all 20 departments · hover to isolate",
    };
    let view = "core";
    const setDefault = () => { if (cap) cap.textContent = DEFAULTS[view]; };
    const setCap = (label) => { if (cap) cap.textContent = label ?? DEFAULTS[view]; };

    Object.values(svgs).filter(Boolean).forEach((graph) => {
      graph.addEventListener("mouseover", (e) => setCap(e.target.closest?.(".graph-cluster")?.dataset?.label));
      graph.addEventListener("focusin", (e) => setCap(e.target.closest?.(".graph-cluster")?.dataset?.label));
      graph.addEventListener("mouseleave", setDefault);
      graph.addEventListener("focusout", (e) => { if (!graph.contains(e.relatedTarget)) setDefault(); });
    });

    const reveal = (graph) => {
      graph.classList.remove("in");
      void graph.getBoundingClientRect();
      requestAnimationFrame(() => requestAnimationFrame(() => graph.classList.add("in")));
    };

    const show = (next) => {
      if (next === view || !svgs[next]) return;
      view = next;
      Object.entries(svgs).forEach(([key, graph]) => {
        graph.hidden = key !== next;
        graph.setAttribute("aria-hidden", String(key !== next));
      });
      reveal(svgs[next]);
      document.querySelectorAll("#graph-switch [data-view]").forEach((b) => {
        const active = b.dataset.view === next;
        b.classList.toggle("is-active", active);
        b.setAttribute("aria-pressed", String(active));
      });
      setDefault();
    };

    document.getElementById("graph-switch")?.addEventListener("click", (e) => {
      const b = e.target.closest?.("[data-view]");
      if (b) show(b.dataset.view);
    });

    svgs.full.hidden = true;
    svgs.full.setAttribute("aria-hidden", "true");
    if (svgs.core) reveal(svgs.core);
  </script>

