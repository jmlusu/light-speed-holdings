  <!-- Sticky install bar — engineer conversion (LightSpeed advantage over Foaster) -->
  <div class="fixed bottom-0 inset-x-0 z-40 bg-[var(--ls-ink)] text-white border-t border-white/10 hidden md:flex items-center justify-center gap-3 py-3 text-[0.84rem]">
    <span class="opacity-80 font-mono">uv sync && ai-company company run</span>
    <button id="sticky-copy" class="rounded-full bg-white text-[var(--ls-ink)] px-3 py-1 font-semibold text-[0.72rem]" data-track="click_sticky_copy">Copy</button>
    <span class="opacity-60">·</span>
    <a href="/docs" class="underline decoration-white/30 underline-offset-4">Read docs</a>
  </div>

  <script is:inline>
    const cmd = "uv sync && ai-company company run";
    const copy = (btn) => {
      navigator.clipboard?.writeText(cmd);
      const orig = btn.textContent;
      btn.textContent = "Copied!";
      setTimeout(() => btn.textContent = orig, 1500);
    };
    document.getElementById('copy-install')?.addEventListener('click', (e) => copy(e.currentTarget.querySelector('span:last-child') || e.currentTarget));
    document.getElementById('cta-copy')?.addEventListener('click', (e) => copy(e.currentTarget));
    document.getElementById('sticky-copy')?.addEventListener('click', (e) => copy(e.currentTarget));
  </script>
