  "cards": [
    {
      "dot": "cyan",
      "title": "P0 Foundation — Routine Engine",
      "items": [
        "5 routines at 04:00 UTC (Mon–Sat) in routines.yaml",
        "Daemon-driven RoutineScheduler with 900s interval",
        "Crash-safe mark-before-send prevents double-fire",
        "Deterministic routine_run_id enables idempotent re-drives"
      ]
    },
    {
      "dot": "amber",
      "title": "P1 Core Loop — Deep Research + Publish",
      "items": [
        "2 deep-research routines (Thu SADC scan, Sat deep brief)",
        "CEO voice profile via semantic + relational memory",
        "Buy-side publish rails: LinkedIn + Substack (no platform API churn)",
        "PublishQueue mirrors to inbox for executor visibility"
      ]
    },
    {
      "dot": "violet",
      "title": "P2 Scale — MCP Surface",
      "items": [
        "5 MCP tools: kg_query, memory_recall, research_lookup, pharos_reference, publish_queue",
        "RBAC: RUN role (read), APPROVE role (write), ADMIN (all)",
        "Every call audit-logged, PII-guarded, content-filtered",
        "Mirrors Eden design but sources from LightSpeed stores"
      ]
    },
    {
      "dot": "rose",
      "title": "Governance & Risk",
      "items": [
        "Never cite Eden corpus as SADC evidence — regional verification pass required",
        "Per-routine budget_tokens + standard model tier control costs",
        "Idempotent routine_run_id + DLQ reuse for scheduler reliability",
        "Eden MCP is optional probe behind feature flag, webfetch fallback"
      ]
    },
    {
      "dot": "emerald",
      "title": "Reuses Existing Infra",
      "items": [
        "Daemon scheduler (same cadence as kpi_snapshot)",
        "MessageBus (.opencode/inbox.json) for task queue",
        "MemoryStore (6 types) + GraphEngine (4 graphs)",
        "RBAC + audit trail from ADR-012/019 patterns",
        "No new schema, no new top-level CLI, no new vendor"
      ]
    }
  ]
