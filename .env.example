# AI Company Builder — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# API keys for LLM providers.
# Active stack: OpenCode (Big Pickle) for standard/premium, Gemini Flash for fast/cheap.
# Deepseek/Kimi are excluded from routing tiers (no African payment/registration path),
# and OpenAI/Anthropic stay in the catalog as future options.
OPENCODE_API_KEY=your_opencode_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional providers (excluded from routing tiers; only set if you enable them)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
KIMI_API_KEY=your_kimi_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Dashboard configuration
DASHBOARD_API_KEY=your_dashboard_api_key_here
DASHBOARD_AUTH_MODE=api_key
DASHBOARD_HOST=0.0.0.0
DASHBOARD_CORS_ORIGINS=http://localhost:8420
DASHBOARD_RATE_LIMIT=100

# RBAC role keys (see src/ai_company/security/rbac.py, ADR-012)
# api_key mode gates requests by X-API-Key (WebSockets use ?api_key=):
# admin > approve > run. DASHBOARD_API_KEY remains a valid admin-key alias.
# These are OPTIONAL: set only if you want granular RBAC instead of the
# single-key DASHBOARD_API_KEY. Leave at placeholder if unused.
DASHBOARD_RUN_KEY=your_run_key_here
DASHBOARD_APPROVE_KEY=your_approve_key_here
DASHBOARD_ADMIN_KEY=your_admin_key_here

# Hard LLM budget caps live in config/company/guardrails.yaml
# (daily $2.00, task $0.50, auto-suspend on overspend). Keys here must match the
# {PROVIDER_ID}_API_KEY naming used by src/ai_company/llm/client.py.

# Key rotation procedure (see AGENTS.md for full documentation):
# 1. Generate new keys for each provider/service
# 2. Update .env with new values (never commit .env)
# 3. Update deployed environments (staging, production) via secrets manager
# 4. Verify dashboard health endpoint responds with new keys
# 5. Revoke old keys after confirming new ones work
# 6. Rotate every 90 days or immediately on suspected compromise

# Staging: copy this file to .env.staging and adjust values as needed.
# .env.staging is gitignored; never commit real keys.
