#!/usr/bin/env python3
"""memory-store — Store a new memory (OpenCode skill tool wrapper)."""

#!/usr/bin/env python3
import subprocess
import sys


def main():
    # Forward all arguments to ai-company memory remember
    cmd = ["ai-company", "memory", "remember"] + sys.argv[1:]
    try:
        result = subprocess.run(cmd, check=True)
        sys.exit(result.returncode)
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)
    except FileNotFoundError:
        print(
            "Error: 'ai-company' command not found. Ensure LightSpeed CLI is installed.",
            file=sys.stderr,
        )
        sys.exit(1)


if __name__ == "__main__":
    main()
