{
  "workflow": "trace_scoring",
  "description": "Score agent traces for anomalies and quality",
  "samples": [
    {
      "input": {
        "trace_id": "trace-001",
        "task": "Research quantum computing papers",
        "agent_id": "research-specialist",
        "steps": [
          {"tool": "web_search", "args": {"query": "quantum error correction 2024"}, "result": {"papers": 15}, "duration_ms": 2100},
          {"tool": "read_paper", "args": {"paper_id": "arxiv:2401.12345"}, "result": {"summary": "..."}, "duration_ms": 5000}
        ],
        "final_output": "Found 15 relevant papers on quantum error correction...",
        "duration_total_ms": 15000,
        "token_usage": {"input": 5000, "output": 2000}
      },
      "expected": {
        "anomaly_score": "normal",
        "task_completion": true,
        "policy_adherence": "full",
        "tool_efficiency": "optimal"
      }
    },
    {
      "input": {
        "trace_id": "trace-002",
        "task": "Deploy to production",
        "agent_id": "ops-specialist",
