          {"tool": "bash", "args": {"command": "kubectl apply -f deployment.yaml"}, "result": {"success": true}, "duration_ms": 5000},
          {"tool": "bash", "args": {"command": "kubectl apply -f deployment.yaml"}, "result": {"success": true}, "duration_ms": 5000}
