# Vercel deployment - React SPA at repo root
# Ignore everything not needed for the frontend build

# Build-critical files MUST survive:
#   package.json, package-lock.json, tsconfig.json, vite.config.ts,
#   index.html, src/, public/, company/agent-registry.json
#   (src/data/companyData.ts imports company/agent-registry.json at build time)

# Python backend
/src/ai_company/
*.py
pyproject.toml
uv.lock
.venv/

# Tests
/tests/
/test_*.py

# Dev / tooling
/.opencode/
/.github/
/.mypy_cache/
/.ruff_cache/
/.pytest_cache/
/node_modules/
/dist/

# Secrets & deploy state
.env*
.vercel/
*.log

# Large non-site directories
/open-design/
/lab/
/scrollcraft/
/bin/
/Branding landing page/
/output/
/tmp/
/reports/
/research/
/evals/
/knowledge/
/prompts/
/proposal-deliverables/
/scripts/
/survey/
/tasks/
/templates/
/whitepaper/
/diagrams/
/.mimocode/
/.playwright-cli/
/.lightspeed/
/.vscode/
/.google notebook artifacts/
/.pytest_tmp*/

# Brand mirror (build needs /brand/tokens/ only — imports from src/pages & src/components)
/static/

# Docs, harness, configs
/docs/
/harness/
/config/
/memory/
/data/
/models/
/results/
/backups/
/archive/
/logs/
/orchestrator/
/sales/
/hr/
/board/
/workflows/
/.benchmarks/
/.hypothesis/
/.ai-company/
/.crush/
/.agents/

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# Other root files
*.md
*.txt
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!index.html
