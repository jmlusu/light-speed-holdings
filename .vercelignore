# Vercel deployment - React SPA at repo root
# Ignore everything not needed for the frontend build

# Build-critical files MUST survive:
#   package.json, package-lock.json, tsconfig.json, vite.config.ts,
#   index.html, src/, public/, company/agent-registry.json
#   (src/data/companyData.ts imports company/agent-registry.json at build time)

# Python backend
/src/ai_company/
*.py
pyproject.toml
uv.lock
.venv/

# Tests
/tests/
/test_*.py

# Dev / tooling
/.opencode/
/.github/
/.mypy_cache/
/.ruff_cache/
/.pytest_cache/
/node_modules/
/dist/

# Secrets & deploy state
.env*
.vercel/
*.log

# Large non-site directories
/open-design/
/lab/
/scrollcraft/
/bin/
/docs/archive/branding-landing-page/
/output/
/tmp/
/reports/
/research/
/evals/
/knowledge/
/prompts/
/proposal-deliverables/
/scripts/
# vercel.json ignoreCommand runs `bash scripts/deploy/vercel-ignore-build.sh`
# in the .vercelignore-filtered context — the script MUST be re-included or
# every deployment fails at the ignore step with ENOENT (exit 127).
!/scripts/deploy/vercel-ignore-build.sh
/survey/
/tasks/
/templates/
/whitepaper/
/diagrams/
/.mimocode/
/.playwright-cli/
/.lightspeed/
/.vscode/
/.google notebook artifacts/
/.pytest_tmp*/

# Brand mirror (build needs /brand/tokens/ only — imports from src/pages & src/components)
/static/

# Docs, harness, configs
/docs/
/harness/
/config/
/memory/
# data/ is runtime/local state, but the 12 site registries aliased in
# vite.config.ts MUST survive the upload or the Vercel build fails with
# ENOENT (root cause of the site-build failures on main).
# Precise pattern (mirrors .gitignore): ignore data/*, re-include only
# <dir>/registry.ts per dir.
/data/*
!/data/capabilities/
/data/capabilities/*
!/data/capabilities/registry.ts
!/data/claims/
/data/claims/*
!/data/claims/registry.ts
!/data/company/
/data/company/*
!/data/company/registry.ts
!/data/ctas/
/data/ctas/*
!/data/ctas/registry.ts
!/data/faqs/
/data/faqs/*
!/data/faqs/registry.ts
!/data/governance/
/data/governance/*
!/data/governance/registry.ts
!/data/insights/
/data/insights/*
!/data/insights/registry.ts
!/data/media/
/data/media/*
!/data/media/registry.ts
!/data/metrics/
/data/metrics/*
!/data/metrics/registry.ts
!/data/sectors/
/data/sectors/*
!/data/sectors/registry.ts
!/data/solutions/
/data/solutions/*
!/data/solutions/registry.ts
!/data/use-cases/
/data/use-cases/*
!/data/use-cases/registry.ts
/models/
/results/
/backups/
/archive/
/logs/
/orchestrator/
/sales/
/hr/
/board/
/workflows/
/.benchmarks/
/.hypothesis/
/.ai-company/
/.crush/
/.agents/

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# Other root files
*.md
*.txt
# robots.txt must ship despite *.txt (negation must follow the rule it overrides)
!/public/robots.txt
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!index.html
